## DO NOT CHANGE ANYTHING HERE
## This file is a placeholder of the .env file that you need to create in the root directory of the project.
OPENAI_API_KEY=put-your-openai-api-key-here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=16384

# Production hardening (set in Railway dashboard for prod; safe to leave blank for local dev).
# APP_PASSWORD: shared password every visitor must enter at /login. If blank, auth is disabled.
# SECRET_KEY: signs session cookies. Generate with `python -c "import secrets; print(secrets.token_hex(32))"`.
# CORS_ALLOWED_ORIGINS: comma-separated origins allowed to call /api/* (e.g. OAPA's WordPress site).
APP_PASSWORD=
SECRET_KEY=
CORS_ALLOWED_ORIGINS=
