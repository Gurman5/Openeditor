{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "instructions": [
    "README.md",
    "docs/api-contract.md",
    "ruff.toml"
  ],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pytest *": "allow",
      "ruff check *": "allow",
      "pip install *": "ask"
    },
    "task": "allow",
    "webfetch": "ask",
    "websearch": "ask"
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 51200
  }
}
