# Environment variables — never commit secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
.venv-wsl/
venv/
env/
ENV/

# CrossRef API disk cache (dev/testing only — delete to force fresh fetches)
app/services/.crossref_cache.json

# Testing & coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
.claude/

# Sample documents (large binaries)
docs/Sample Documents/
tests/generated_outputs
tests/section_sepcif_docs_for_testing
# NOTE: tests/jutlp_sample_docx_test_pack is NOT ignored — it holds the
# numbered fixtures (01–06) that the test suite depends on. Keep it tracked.

# OS
.DS_Store
Thumbs.db

# Microsoft Office lock / temp files (e.g. ~$Document.docx)
~$*.docx
~$*.doc
~$*.xlsx
~$*.pptx

# Cache from
graphify-out/**/cache/

# graphify auto-backups, one dir per run date (e.g. graphify-out/2026-09-29/).
# Overwritten each run, so they are a local safety net, not history.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# graphify scratch sidecars - regenerated on every run, never worth committing
graphify-out/.graphify_incremental.json
graphify-out/.graphify_labels.json.sig

# Machine-local: absolute interpreter path, scan root, personal token tracker.
# Meaningless on any other clone, so keep them out of the shared repo.
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cost.json
graphify-out/graph.js
.ua/

# Track K corpus documents
tests/corpus/real/*
!tests/corpus/real/.gitkeep

tests/corpus/samples/*
!tests/corpus/samples/.gitkeep